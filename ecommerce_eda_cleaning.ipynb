
# ============================================================
# E-commerce Sales Analytics
# Data Cleaning & Exploratory Data Analysis (EDA)
# ============================================================

import pandas as pd
import numpy as np
from pathlib import Path

# ------------------------------------------------------------
# 1. Load Dataset
# ------------------------------------------------------------

file_path = "Ecommerce_Sales_Data.xlsx"

if not Path(file_path).exists():
    raise FileNotFoundError(
        f"ไม่พบไฟล์ {file_path} กรุณาอัปโหลดไฟล์ Excel "
        "ไว้ในโฟลเดอร์เดียวกับ Notebook"
    )

df = pd.read_excel(file_path)

print("=" * 60)
print("1. DATASET OVERVIEW")
print("=" * 60)

print(f"Number of rows: {df.shape[0]:,}")
print(f"Number of columns: {df.shape[1]}")
print("\nColumn names:")
print(df.columns.tolist())

print("\nData types and non-null counts:")
df.info()

print("\nFirst 5 rows:")
display(df.head())


# ------------------------------------------------------------
# 2. Data Quality Checks
# ------------------------------------------------------------

print("\n" + "=" * 60)
print("2. DATA QUALITY CHECKS")
print("=" * 60)

print("\nMissing values:")
missing_summary = (
    df.isnull()
    .sum()
    .to_frame(name="Missing Count")
)

missing_summary["Missing Percentage (%)"] = (
    missing_summary["Missing Count"] / len(df) * 100
).round(2)

display(missing_summary)

duplicate_count = df.duplicated().sum()
print(f"\nDuplicate rows: {duplicate_count:,}")

# ตรวจสอบแถวที่มีค่าติดลบ
print("\nNegative values:")
for col in ["Quantity", "UnitPrice", "Total Sales"]:
    if col in df.columns:
        print(f"{col}: {(df[col] < 0).sum():,}")

# หมายเหตุ:
# ไม่เติม Missing Values เป็น 0 โดยอัตโนมัติ
# และยังไม่ลบแถวซ้ำ เพราะควรตรวจสอบก่อนว่าเป็นข้อมูลซ้ำจริงหรือไม่


# ------------------------------------------------------------
# 3. Data Cleaning and Type Conversion
# ------------------------------------------------------------

print("\n" + "=" * 60)
print("3. DATA CLEANING")
print("=" * 60)

required_columns = [
    "InvoiceNo",
    "StockCode",
    "Description",
    "Quantity",
    "InvoiceDate",
    "UnitPrice",
    "CustomerID",
    "Country",
    "Total Sales"
]

missing_columns = [
    col for col in required_columns
    if col not in df.columns
]

if missing_columns:
    raise ValueError(
        f"Missing required columns: {missing_columns}"
    )

# แปลงวันที่ให้อยู่ในรูปแบบ datetime
df["InvoiceDate"] = pd.to_datetime(
    df["InvoiceDate"],
    errors="coerce"
)

# แปลงคอลัมน์ตัวเลข
numeric_columns = [
    "Quantity",
    "UnitPrice",
    "Total Sales",
    "CustomerID"
]

for col in numeric_columns:
    df[col] = pd.to_numeric(
        df[col],
        errors="coerce"
    )

# แปลง InvoiceNo เป็นข้อความ เพื่อรองรับการตรวจสอบ
# Invoice ที่ขึ้นต้นด้วย C ซึ่งมักใช้แทนรายการยกเลิก
df["InvoiceNo"] = df["InvoiceNo"].astype("string").str.strip()

print("Data types after conversion:")
print(df.dtypes)

print("\nMissing values after conversion:")
print(df.isnull().sum())


# ------------------------------------------------------------
# 4. Feature Engineering
# ------------------------------------------------------------

print("\n" + "=" * 60)
print("4. FEATURE ENGINEERING")
print("=" * 60)

# สร้างคอลัมน์เดือนสำหรับวิเคราะห์แนวโน้มยอดขาย
df["YearMonth"] = (
    df["InvoiceDate"]
    .dt.to_period("M")
    .astype("string")
)

# แยกรายการ Invoice ที่ขึ้นต้นด้วย C
df["IsCancellation"] = (
    df["InvoiceNo"]
    .str.startswith("C", na=False)
)

print(
    "Cancellation invoice rows:",
    f"{df['IsCancellation'].sum():,}"
)

print(
    "Rows with missing CustomerID:",
    f"{df['CustomerID'].isna().sum():,}"
)


# ------------------------------------------------------------
# 5. Key Business Metrics
# ------------------------------------------------------------

print("\n" + "=" * 60)
print("5. KEY BUSINESS METRICS")
print("=" * 60)

# ใช้ Total Sales เป็นยอดขายของแต่ละแถว
# คำนวณจากข้อมูลที่มีค่า InvoiceNo และ Total Sales
valid_sales = df.dropna(
    subset=["InvoiceNo", "Total Sales"]
).copy()

# ยอดขายรวมสุทธิ รวมรายการติดลบที่มีอยู่ในข้อมูล
total_revenue = valid_sales["Total Sales"].sum()

# จำนวน Invoice ที่ไม่ใช่รายการยกเลิก
sales_invoices = valid_sales.loc[
    ~valid_sales["IsCancellation"],
    "InvoiceNo"
].nunique()

# AOV = ยอดขายรวมสุทธิ / จำนวน Invoice ขายที่ไม่ซ้ำ
aov = (
    total_revenue / sales_invoices
    if sales_invoices > 0
    else np.nan
)

total_customers = df["CustomerID"].nunique()
total_products = df["StockCode"].nunique()
total_countries = df["Country"].nunique()

print(f"Total Revenue (net): {total_revenue:,.2f}")
print(f"Unique Sales Invoices: {sales_invoices:,}")
print(f"Average Order Value (AOV): {aov:,.2f}")
print(f"Unique Customers: {total_customers:,}")
print(f"Unique Products: {total_products:,}")
print(f"Countries: {total_countries:,}")

print(
    "\nNote: AOV uses net revenue, including negative sales "
    "adjustments, divided by unique non-cancellation invoices."
)


# ------------------------------------------------------------
# 6. Monthly Sales Analysis
# ------------------------------------------------------------

print("\n" + "=" * 60)
print("6. MONTHLY SALES ANALYSIS")
print("=" * 60)

monthly_sales = (
    valid_sales.dropna(subset=["YearMonth"])
    .groupby("YearMonth", as_index=False)
    .agg(
        Total_Sales=("Total Sales", "sum"),
        Invoice_Count=("InvoiceNo", "nunique")
    )
    .sort_values("YearMonth")
)

display(monthly_sales)

if not monthly_sales.empty:
    best_month = monthly_sales.loc[
        monthly_sales["Total_Sales"].idxmax()
    ]

    print(
        f"Highest sales month: {best_month['YearMonth']}"
    )
    print(
        f"Sales in that month: "
        f"{best_month['Total_Sales']:,.2f}"
    )


# ------------------------------------------------------------
# 7. Sales by Country
# ------------------------------------------------------------

print("\n" + "=" * 60)
print("7. SALES BY COUNTRY")
print("=" * 60)

country_sales = (
    valid_sales.groupby("Country", as_index=False)
    .agg(
        Total_Sales=("Total Sales", "sum"),
        Invoice_Count=("InvoiceNo", "nunique"),
        Unique_Customers=("CustomerID", "nunique")
    )
    .sort_values("Total_Sales", ascending=False)
)

print("Top 10 countries by sales:")
display(country_sales.head(10))


# ------------------------------------------------------------
# 8. Top Products by Sales
# ------------------------------------------------------------

print("\n" + "=" * 60)
print("8. TOP PRODUCTS BY SALES")
print("=" * 60)

product_sales = (
    valid_sales.groupby(
        ["StockCode", "Description"],
        dropna=False,
        as_index=False
    )
    .agg(
        Total_Sales=("Total Sales", "sum"),
        Total_Quantity=("Quantity", "sum")
    )
    .sort_values("Total_Sales", ascending=False)
)

print("Top 10 products by total sales:")
display(product_sales.head(10))


# ------------------------------------------------------------
# 9. Customer Analysis
# ------------------------------------------------------------

print("\n" + "=" * 60)
print("9. CUSTOMER ANALYSIS")
print("=" * 60)

customer_sales = (
    valid_sales.dropna(subset=["CustomerID"])
    .groupby("CustomerID", as_index=False)
    .agg(
        Total_Sales=("Total Sales", "sum"),
        Invoice_Count=("InvoiceNo", "nunique")
    )
    .sort_values("Total_Sales", ascending=False)
)

print("Top 10 customers by total sales:")
display(customer_sales.head(10))


# ------------------------------------------------------------
# 10. Final Data Quality Summary
# ------------------------------------------------------------

print("\n" + "=" * 60)
print("10. FINAL SUMMARY")
print("=" * 60)

print(f"Rows in dataset: {len(df):,}")
print(f"Duplicate rows detected: {duplicate_count:,}")
print(
    f"Rows with missing InvoiceDate: "
    f"{df['InvoiceDate'].isna().sum():,}"
)
print(
    f"Rows with missing Total Sales: "
    f"{df['Total Sales'].isna().sum():,}"
)
print(
    f"Rows with missing CustomerID: "
    f"{df['CustomerID'].isna().sum():,}"
)

print("\nData cleaning and EDA completed.")
print("Review data quality findings before removing or imputing data.")
